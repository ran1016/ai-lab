# 复制为 .env 后修改
SECRET_KEY=change-this-to-a-random-secret

# 数据库：默认 SQLite 零配置运行；可切换 PostgreSQL / MySQL
DATABASE_URL=sqlite:///site.db
# PostgreSQL 示例：
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/personaldb
# MySQL 示例：
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/personaldb

# 后台管理员账号（/admin/login）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 简历智能解析（可选）：配置后启用大模型精准解析，未配置则自动回退到本地规则解析
# 接口兼容 OpenAI，可指向 Qwen / DeepSeek / GPT 等
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
